# Instagram API with Instagram Login (NO Facebook Page required)
# Guide: INSTAGRAM_SETUP.md
#
# 1. Meta app type: Business
# 2. Add Instagram → "API setup with Instagram business login"
# 3. Generate token next to @theuntoldphrase (instagram_business_basic)
# 4. Optional long-lived: npm run ig:exchange -- --token=SHORT --app-secret=SECRET --provider=instagram
# 5. Paste below, then: npm run ig:verify && npm run dev

IG_ACCESS_TOKEN=
IG_USER_ID=me
